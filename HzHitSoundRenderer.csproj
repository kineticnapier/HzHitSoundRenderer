<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HzHitSoundRenderer</AssemblyName>
    <RootNamespace>HzHitSoundRenderer</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GameManagedDir Condition=" '$(GameManagedDir)' == '' and '$(ADOFAI_GAME_MANAGED_DIR)' != '' and Exists('$(ADOFAI_GAME_MANAGED_DIR)\Assembly-CSharp.dll') ">$(ADOFAI_GAME_MANAGED_DIR)</GameManagedDir>
    <GameManagedDir Condition=" '$(GameManagedDir)' == '' and '$(ADOFAI_DIR)' != '' and Exists('$(ADOFAI_DIR)\A Dance of Fire and Ice_Data\Managed\Assembly-CSharp.dll') ">$(ADOFAI_DIR)\A Dance of Fire and Ice_Data\Managed</GameManagedDir>
    <DefaultSteamGameDir>$([System.Environment]::GetFolderPath(SpecialFolder.ProgramFilesX86))\Steam\steamapps\common\A Dance of Fire and Ice</DefaultSteamGameDir>
    <GameManagedDir Condition=" '$(GameManagedDir)' == '' and Exists('$(DefaultSteamGameDir)\A Dance of Fire and Ice_Data\Managed\Assembly-CSharp.dll') ">$(DefaultSteamGameDir)\A Dance of Fire and Ice_Data\Managed</GameManagedDir>
    <GameManagedDir Condition=" '$(GameManagedDir)' == '' ">$(MSBuildProjectDirectory)\reference\Managed</GameManagedDir>
    <UmmDir Condition=" '$(UmmDir)' == '' ">$(GameManagedDir)\UnityModManager</UmmDir>
    <!-- Unity 6 defines Span<T> in its own mscorlib. Only override the compiler
         framework path after the selected Managed directory has been validated. -->
    <FrameworkPathOverride Condition=" '$(FrameworkPathOverride)' == '' and Exists('$(GameManagedDir)\mscorlib.dll') ">$(GameManagedDir)</FrameworkPathOverride>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(UmmDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="netstandard, Version=2.1.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51">
      <HintPath>$(GameManagedDir)\netstandard.dll</HintPath>
      <SpecificVersion>True</SpecificVersion>
      <Private>False</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(GameManagedDir)\RDTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(UmmDir)\UnityModManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="PrepareForBuild">
    <Error Condition=" !Exists('$(GameManagedDir)\Assembly-CSharp.dll') "
           Text="ADOFAI Managed DLLs were not found at '$(GameManagedDir)'. Set ADOFAI_GAME_MANAGED_DIR to the game's Managed folder." />
    <Error Condition=" !Exists('$(UmmDir)\UnityModManager.dll') or !Exists('$(UmmDir)\0Harmony.dll') "
           Text="Unity Mod Manager DLLs were not found at '$(UmmDir)'. Install UMM or pass UmmDir to dotnet build." />
  </Target>

  <!--
    Set ADOFAI_GAME_MANAGED_DIR to the Managed folder, or ADOFAI_DIR to the
    game folder. GameManagedDir and UmmDir can also be passed to dotnet build.
    Example:
      setx ADOFAI_DIR "C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice"
  -->
</Project>
